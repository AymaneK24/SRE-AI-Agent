# An internal host name with your company's certificate, from deploy/certs.
{
	admin off
	auto_https disable_redirects
	# Browsers and Windows send no server name when you open https://IP-ADDRESS, so Caddy needs to know
	# which certificate to use. Without this, connecting by IP fails with a TLS internal error.
	default_sni {$RCC_DEFAULT_SNI:localhost}
}
{$RCC_DOMAIN} {
	tls /certs/cert.pem /certs/key.pem
	encode gzip
	header -Server
	@internal path /metrics
	respond @internal 404
	reverse_proxy console:8000 {
		flush_interval -1
	}
}
