# deploy/setup-env.sh writes this file for you, with new secrets. This shows what each setting does.

# The address people use. It's always HTTPS, and links in emails use it.
RCC_DOMAIN=rcc.company.internal
# The certificate for clients that send no server name, which happens when people open https://IP-ADDRESS.
# Set it to the IP address people use. With several addresses in RCC_DOMAIN, pick the one others connect to.
RCC_DEFAULT_SNI=rcc.company.internal
RCC_PUBLIC_URL=https://rcc.company.internal
RCC_ALLOWED_HOSTS=rcc.company.internal
# The certificate. A private server, reached over VPN or your network, is recommended:
#   ./deploy/Caddyfile.internal     your company's certificate, in deploy/certs (private, recommended)
#   ./deploy/Caddyfile.selfsigned   made by this server (private, browsers warn until you trust it)
#   ./deploy/Caddyfile.azure-dns    Let's Encrypt through Azure DNS (private, needs RCC_CADDY_IMAGE=rcc-caddy-dns:2)
#   ./deploy/Caddyfile              Let's Encrypt over the internet (public, ports 80 and 443 open)
RCC_CADDYFILE=./deploy/Caddyfile.selfsigned
RCC_CADDY_IMAGE=caddy:2-alpine
# Only for Caddyfile.azure-dns: where the public DNS zone is. The VM's managed identity signs in.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=
RCC_HTTPS_PORT=443
RCC_COMPANY_NAME=

# Make each with: openssl rand -hex 32. Without RCC_SECRET_KEY, saved credentials can't be read.
RCC_SECRET_KEY=
POSTGRES_PASSWORD=

# The first administrator. People sign in with their email. This password must be changed at first sign-in.
RCC_ADMIN_NAME=
RCC_ADMIN_EMAIL=
RCC_ADMIN_PASSWORD=

# AI model. Use Ollama on your network, a Claude API key from the Claude Console, or a Gemini API key from
# Google AI Studio. All can also be set in the app, where keys are stored encrypted.
RCC_OLLAMA_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=
RCC_GEMINI_API_KEY=

# Optional: an email server for invitations, password resets, and email alerts.
RCC_SMTP_HOST=
RCC_SMTP_PORT=587
RCC_SMTP_USERNAME=
RCC_SMTP_PASSWORD=
RCC_SMTP_FROM=
RCC_SMTP_TLS=starttls

# How long an alert email waits for its automatic investigation, in seconds. After this, the alert goes out and the findings follow.
# RCC_ALERT_EMAIL_WAIT_SECONDS=600

# Optional: limit where this server may connect. Host names, IP addresses, or ranges, separated by commas.
# RCC_TARGET_ALLOWLIST=prometheus,10.20.0.0/16

# For running the app directly on one machine during development. Lets a target be this same machine.
# RCC_ALLOW_LOOPBACK_TARGETS=true

# The company that runs this installation. Shown on the privacy notice, terms, cookie policy, and legal notice,
# because it is responsible for the personal data stored here (the controller under the GDPR and law 09-08).
RCC_OPERATOR_NAME=Your Company
RCC_OPERATOR_ADDRESS=
RCC_CONTACT_EMAIL=privacy@company.com
# Set to true once your lawyer has reviewed the policy pages. Until then they show a "Draft" note.
RCC_LEGAL_REVIEWED=false
